#: pretix_order_limits/templates/pretix_order_limits/settings.html:7
msgid "Order limits"
msgstr "Limity objednávek"

#: pretix_order_limits/apps.py:15
msgid "Limit order sizes by event date and sales channel."
msgstr "Omezuje velikost objednávek podle termínu a prodejního kanálu."

#: pretix_order_limits/apps.py:21
msgid "Settings"
msgstr "Nastavení"

#: pretix_order_limits/forms.py:42
msgid "Event"
msgstr "Akce"

#: pretix_order_limits/signals.py:16
#, python-format
msgid ""
"You can order at most %(limit)s ticket for this event in a single order."
msgid_plural ""
"You can order at most %(limit)s tickets for this event in a single order."
msgstr[0] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenku na tuto akci."
msgstr[1] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenky na tuto akci."
msgstr[2] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenky na tuto akci."
msgstr[3] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenek na tuto akci."

#: pretix_order_limits/signals.py:21
#, python-format
msgid "You can order at most %(limit)s ticket for %(date)s in a single order."
msgid_plural ""
"You can order at most %(limit)s tickets for %(date)s in a single order."
msgstr[0] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenku na termín %(date)s."
msgstr[1] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenky na termín %(date)s."
msgstr[2] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenky na termín %(date)s."
msgstr[3] "V jedné objednávce můžete objednat nejvýše %(limit)s vstupenek na termín %(date)s."

#: pretix_order_limits/templates/pretix_order_limits/settings.html:9
msgid ""
"Set the maximum number of tickets from one event date that may be included "
"in a single order. Empty fields do not impose a limit. Add-on products are "
"not counted."
msgstr ""
"Nastavte nejvyšší počet vstupenek z jednoho termínu, které mohou "
"být v jedné objednávce. Prázdné pole limit neurčuje. Doplňkové produkty "
"se nepočítají."

#: pretix_order_limits/templates/pretix_order_limits/settings.html:20
msgid "Event date"
msgstr "Termín"

#: pretix_order_limits/templates/pretix_order_limits/settings.html:38
msgid "This event has no dates."
msgstr "Tato akce nemá žádné termíny."

#: pretix_order_limits/templates/pretix_order_limits/settings.html:44
msgid "Save"
msgstr "Uložit"

#: pretix_order_limits/views.py:42
msgid "The order limits have been saved."
msgstr "Limity objednávek byly uloženy."

#: pretix_order_limits/views.py:44
msgid "No settings were changed."
msgstr "Nedošlo k žádné změně nastavení."
